# Template for wrangler.toml — copy it, then fill in your own values:
#
#   cp wrangler.toml.example wrangler.toml
#
# wrangler.toml itself is gitignored: it names YOUR Worker and YOUR D1 database, so it is
# per-deployment config, not shared source. Same pattern as .dev.vars / .dev.vars.example.
# If you change a binding here, mirror it into this example so other deployments pick it up.

# Your Worker's name. It becomes the hostname: <name>.<your-subdomain>.workers.dev
name = "alliance-tracker"

main = "src/index.ts"
compatibility_date = "2026-07-22"

[[d1_databases]]
binding = "DB"

# Create the database first, then paste its name and id here:
#   npx wrangler d1 create alliance-tracker-db
# The command prints both. Everything else (migrations, seed) addresses the database through
# the "DB" binding above, so these two values are the only place your database name appears.
database_name = "alliance-tracker-db"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

migrations_dir = "migrations"

# Rate limiting lives in the Worker rather than the WAF, because WAF rules are zone-level and
# do not apply to workers.dev. 120 requests per 60s per client IP, applied in front of auth.
# namespace_id is a local identifier for this binding — any stable integer works.
[[ratelimits]]
name = "API_RATE_LIMIT"
namespace_id = "1001"

  [ratelimits.simple]
  limit = 120
  period = 60

# Serves the built SPA from dist/. `npm run deploy` builds the SPA before deploying.
# Workers AI: reads ranking/roster screenshots (Add Event, Import Roster). Free tier: 10k neurons/day,
# hard stop past that on the Free plan. `remote = true` so `wrangler dev` uses the real model.
[ai]
binding = "AI"
remote = true

# Optional tuning for the screenshot reader. Every value below is the default; set a var to override it
# (in wrangler.toml under [vars], or in .dev.vars for local dev). Anything unset, blank or non-numeric
# falls back to the default. See docs/guides/events.md → From screenshots.
# [vars]
# AI_MODEL = "@cf/google/gemma-4-26b-a4b-it"   # any Workers AI chat model that accepts images
# AI_DAILY_NEURON_LIMIT = "10000"              # Cloudflare's free allowance per day
# AI_NEURONS_PER_READ = "5"                    # measured cost of one read; drives "screenshots left"
# AI_RESERVE_NEURONS = "50"                    # refuse a read when fewer neurons than this remain
# AI_DAILY_REQUEST_CAP = "400"                 # hard cap on reads per day
# AI_MAX_TOKENS = "2500"
# AI_THINKING = "false"                        # "true" = slower, ~7x the neurons, slightly better names
#
# Event scheduling + Discord notifications (docs/guides/schedule.md). Off by default: uncomment BOTH
# the two vars below and the [triggers] block after them. The cron is what costs invocations
# (1440/day); the var is what shows the section. The vars belong in the same [vars] table as the AI
# ones above, which is why they sit inside that block.
# SCHEDULER_ENABLED = "true"
# NOTIFY_LANGUAGES = "en,es,fr,de,ko,ar"       # default; overridden at runtime by the in-app setting

# [triggers]
# crons = ["* * * * *"]

[assets]
directory = "dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
